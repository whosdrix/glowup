---
import { resolveImage } from '../../lib/site'
import Picture from '../Picture.astro'
import Section from '../Section.astro'
import SectionHeading from '../SectionHeading.astro'

interface Props {
  /** mosaic: uneven cells, images cropped to fit. grid: equal cells with captions underneath. */
  variant?: 'mosaic' | 'grid'
  id?: string
  tone?: string
  eyebrow?: string
  heading?: string
  intro?: string
  images: string[]
}

const { variant = 'mosaic', id, tone, eyebrow, heading, intro, images } = Astro.props

// Five-cell pattern on a 12-column grid, repeated for longer galleries.
const cells = [
  'md:col-span-7 md:row-span-2',
  'md:col-span-5',
  'md:col-span-5',
  'md:col-span-4',
  'md:col-span-8',
]
---

<Section id={id} tone={tone}>
  <div class="grid gap-x-12 gap-y-4 lg:grid-cols-12 lg:items-end">
    <SectionHeading class="lg:col-span-7" eyebrow={eyebrow} heading={heading} />
    {intro && <p class="max-w-measure text-ink-muted lg:col-span-5">{intro}</p>}
  </div>

  {
    variant === 'mosaic' ? (
      <ul class="mosaic mt-block grid grid-cols-2 gap-3 md:grid-cols-12 md:gap-4">
        {images.map((key, i) => (
          <li class:list={[cells[i % cells.length], i % cells.length === 0 && 'col-span-2', 'min-h-0']}>
            <Picture image={key} ratio="auto" sizes="(min-width: 48rem) 55vw, 100vw" class="h-full" />
          </li>
        ))}
      </ul>
    ) : (
      <ul class="mt-block grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-3">
        {images.map((key) => {
          const caption = resolveImage(key).caption
          return (
            <li>
              <figure>
                <Picture image={key} ratio="4/5" sizes="(min-width: 64rem) 30vw, 50vw" />
                {caption && <figcaption class="mt-3 text-sm text-ink-muted">{caption}</figcaption>}
              </figure>
            </li>
          )
        })}
      </ul>
    )
  }
</Section>

<style>
  .mosaic {
    grid-auto-rows: clamp(9rem, 42vw, 13rem);
  }

  @media (min-width: 48rem) {
    .mosaic {
      grid-auto-rows: clamp(11rem, 19vw, 17rem);
    }

    /* Close the gap a leftover cell would leave at the end of the pattern. */
    .mosaic li:last-child:nth-child(5n + 2) {
      grid-row: span 2;
    }

    .mosaic li:last-child:nth-child(5n + 4) {
      grid-column: 1 / -1;
    }
  }
</style>

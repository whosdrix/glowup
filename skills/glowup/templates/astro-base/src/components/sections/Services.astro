---
import type { Link } from '../../lib/site'
import { site } from '../../lib/site'
import Arrow from '../Arrow.astro'
import Picture from '../Picture.astro'
import Section from '../Section.astro'
import SectionHeading from '../SectionHeading.astro'

interface Item {
  title: string
  text?: string
  /** Short fact shown on the right: a price, a duration. Only if the source site states it. */
  meta?: string
  detail?: string
  href?: string
  image?: string
}

interface Props {
  /** list: numbered rows beside a sticky heading. cards: a grid, first card wide. */
  variant?: 'list' | 'cards'
  id?: string
  tone?: string
  eyebrow?: string
  heading?: string
  intro?: string
  items: Item[]
  link?: Link
}

const { variant = 'list', id, tone, eyebrow, heading, intro, items, link } = Astro.props
const num = (i: number) => String(i + 1).padStart(2, '0')
---

<Section id={id} tone={tone}>
  {
    variant === 'list' ? (
      <div class="grid gap-x-12 gap-y-10 lg:grid-cols-12">
        <SectionHeading class="lg:sticky lg:top-10 lg:col-span-4 lg:self-start" eyebrow={eyebrow} heading={heading} intro={intro}>
          {link && (
            <a class="link mt-6" href={link.href}>
              {link.label}
              <Arrow />
            </a>
          )}
        </SectionHeading>
        <ol class="border-b border-line lg:col-span-8">
          {items.map((item, i) => (
            <li class="grid grid-cols-[2.75rem_1fr] gap-x-4 gap-y-2 border-t border-line py-7 md:grid-cols-[4rem_1fr_auto] md:gap-x-8">
              <span class="pt-1.5 text-sm font-semibold text-accent-text tabular-nums" aria-hidden="true">
                {num(i)}
              </span>
              <div>
                <h3 class="display text-xl">
                  {item.href ? (
                    <a class="underline decoration-transparent decoration-2 underline-offset-4 transition-colors hover:decoration-accent" href={item.href}>
                      {item.title}
                    </a>
                  ) : (
                    item.title
                  )}
                </h3>
                {item.text && <p class="mt-2 max-w-[46ch] text-ink-muted">{item.text}</p>}
              </div>
              {(item.meta || item.detail) && (
                <p class="col-start-2 md:col-start-3 md:pt-1 md:text-right">
                  {item.meta && <span class="block font-semibold">{item.meta}</span>}
                  {item.detail && <span class="block text-sm text-ink-muted">{item.detail}</span>}
                </p>
              )}
            </li>
          ))}
        </ol>
      </div>
    ) : (
      <div>
        <div class="flex flex-wrap items-end justify-between gap-6">
          <SectionHeading eyebrow={eyebrow} heading={heading} intro={intro} />
          {link && (
            <a class="link" href={link.href}>
              {link.label}
              <Arrow />
            </a>
          )}
        </div>
        <ul class="mt-block grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {items.map((item, i) => (
            <li class:list={['flex flex-col rounded-(--image-radius) bg-surface p-6 lg:p-8', i === 0 && item.image && 'md:col-span-2 md:flex-row md:gap-8']}>
              {item.image && (
                <Picture
                  image={item.image}
                  ratio="4/3"
                  sizes="(min-width: 64rem) 30vw, (min-width: 48rem) 45vw, 100vw"
                  class={`mb-6 rounded-md! ${i === 0 ? 'md:mb-0 md:w-1/2 md:shrink-0' : ''}`}
                />
              )}
              <div class="flex grow flex-col">
                <p class="text-sm font-semibold text-accent-text tabular-nums" aria-hidden="true">{num(i)}</p>
                <h3 class="display mt-3 text-xl">{item.title}</h3>
                {item.text && <p class="mt-3 text-ink-muted">{item.text}</p>}
                <div class="grow" />
                {(item.meta || item.detail) && (
                  <p class="mt-6 border-t border-line pt-4">
                    {item.meta && <span class="font-semibold">{item.meta}</span>}
                    {item.detail && <span class="ml-2 text-sm text-ink-muted">{item.detail}</span>}
                  </p>
                )}
                {item.href && (
                  <a class="link mt-2 self-start" href={item.href}>
                    <span>{site.labels.details}<span class="sr-only">: {item.title}</span></span>
                    <Arrow />
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</Section>

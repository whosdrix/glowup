---
import { isCurrent, site } from '../../lib/site'

const { business, nav, cta, labels } = site
const path = Astro.url.pathname
---

<header class="site-header relative border-b border-line">
  <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-x-8 px-gutter">
    <a href="/" class="flex min-h-18 items-center py-3" aria-label={`${business.name}, ${labels.home}`}>
      {
        business.logo ? (
          <img
            src={business.logo.src}
            alt={business.logo.alt}
            width={business.logo.width}
            height={business.logo.height}
            class="h-10 w-auto"
          />
        ) : (
          <span class="display text-lg leading-none sm:text-xl">{business.name}</span>
        )
      }
    </a>

    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-bars" aria-hidden="true"></span>
      {labels.menu}
    </button>

    <nav id="site-nav" class="site-nav" aria-label={labels.menu}>
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a class="nav-link" href={item.href} aria-current={isCurrent(item.href, path) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      {
        cta && (
          <a class="btn btn-primary nav-cta" href={cta.href}>
            {cta.label}
          </a>
        )
      }
    </nav>
  </div>
</header>

<script is:inline>
  // Without this script the menu is simply always open, which is the fallback.
  ;(() => {
    const toggle = document.querySelector('.nav-toggle')
    const nav = document.getElementById('site-nav')
    if (!toggle || !nav) return
    const set = (open) => {
      toggle.setAttribute('aria-expanded', String(open))
      nav.toggleAttribute('data-open', open)
    }
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'))
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        set(false)
        toggle.focus()
      }
    })
    nav.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) set(false)
    })
  })()
</script>

<style>
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 2rem;
    padding-block: 0.5rem;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: underline transparent 2px;
    text-underline-offset: 0.45em;
    transition: text-decoration-color 160ms ease;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    text-decoration-color: var(--color-accent);
  }

  .nav-cta {
    min-height: 2.75rem;
    padding-block: 0.5rem;
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 63.99rem) {
    :global(.js) .nav-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 2.75rem;
      padding-inline: 1rem;
      border: var(--rule-weight) solid var(--color-ink);
      border-radius: var(--button-radius);
      font-size: var(--text-sm);
      font-weight: 600;
    }

    .nav-toggle-bars {
      width: 1rem;
      height: 0.5rem;
      border-block: 2px solid currentColor;
    }

    :global(.js) .site-nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      z-index: 20;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding: 0.5rem var(--spacing-gutter) 1.75rem;
      background: var(--color-bg);
      border-bottom: var(--rule-weight) solid var(--color-line);
      box-shadow: 0 1.5rem 2rem -1.5rem rgb(0 0 0 / 0.25);
    }

    :global(.js) .site-nav[data-open] {
      display: flex;
    }

    :global(.js) .nav-list {
      flex-direction: column;
    }

    :global(.js) .nav-link {
      display: flex;
      min-height: 3.25rem;
      border-bottom: var(--rule-weight) solid var(--color-line);
      font-size: var(--text-base);
    }
  }
</style>

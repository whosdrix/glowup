---
import { plain, rich, site } from '../lib/site'

interface Props {
  title: string
  eyebrow?: string
  intro?: string
}

const { title, eyebrow, intro } = Astro.props
---

<div class="mx-auto max-w-page px-gutter pt-10 lg:pt-16">
  <nav aria-label={site.labels.breadcrumb} class="text-sm text-ink-muted">
    <a class="inline-flex min-h-11 items-center underline decoration-line decoration-2 underline-offset-4 hover:decoration-accent" href="/">{site.labels.home}</a>
    <span class="mx-2" aria-hidden="true">/</span>
    <span aria-current="page">{plain(title)}</span>
  </nav>
  <div class="mt-6 grid gap-x-12 gap-y-6 border-b border-line pb-block lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h1 class="display text-4xl" set:html={rich(title)} />
    </div>
    {intro && <p class="max-w-measure text-lg text-ink-muted lg:col-span-5">{intro}</p>}
  </div>
</div>
